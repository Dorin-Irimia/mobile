{
  "expo": {
    "name": "Urbio Auto",
    "slug": "urbio-auto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.urbio.auto",
      "infoPlist": {
        "NSCameraUsageDescription": "Urbio Auto folosește camera pentru a scana documente și fotografii vehicule.",
        "NSPhotoLibraryUsageDescription": "Urbio Auto accesează galeria pentru a adăuga fotografii.",
        "NSFaceIDUsageDescription": "Urbio Auto folosește Face ID pentru autentificare rapidă.",
        "NSLocationWhenInUseUsageDescription": "Urbio Auto folosește locația ta pentru a completa automat adresa la cheltuieli și alimentări.",
        "NSCalendarsUsageDescription": "Urbio Auto adaugă scadențele ITP/RCA și reminderele în calendarul telefonului ca să nu le ratezi.",
        "NSCalendarsFullAccessUsageDescription": "Urbio Auto are nevoie de acces la calendar pentru a salva termenele și reminderele."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF6B1A"
      },
      "package": "ro.urbio.auto",
      "edgeToEdgeEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      [
        "expo-calendar",
        {
          "calendarPermission": "Urbio Auto folosește calendarul pentru a salva scadențele ITP/RCA și reminderele tale."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B1A"
        }
      ],
      "expo-local-authentication",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Urbio Auto folosește locația pentru a completa adresa la cheltuieli și alimentări."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#FF6B1A",
      "androidMode": "default",
      "androidCollapsedTitle": "Urbio Auto",
      "iosDisplayInForeground": true
    },
    "extra": {
      "eas": {
        "projectId": "0063a3aa-7f75-4a48-80cb-8f3fb3ae4b45"
      }
    },
    "owner": "dirimia436",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0063a3aa-7f75-4a48-80cb-8f3fb3ae4b45"
    }
  }
}
